{
  "branches": [
    {
      "name": "main"
    },
    {
      "name": "next",
      "channel": "next",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "CHECKSHIP_VERSION=${nextRelease.version} make prepare-release && sh -c \"if [ ${branch.name} = 'next' ]; then echo 'docker_tags=ghcr.io/checkship-deploy/checkship:next'; else echo 'docker_tags=ghcr.io/checkship-deploy/checkship:${nextRelease.version},ghcr.io/checkship-deploy/checkship:latest'; fi\" >> \"$GITHUB_ENV\"",
        "publishCmd": "echo \"docker_publish=true\" >> \"$GITHUB_ENV\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "cmd/version/version.go"
        ],
        "message": "chore(release): bump version to ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
